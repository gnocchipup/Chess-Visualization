{
  "name": "Chess Visualization for Noobs",
  "short_name": "Chess Noobs",
  "description": "Drill chess tactics: walk through a game's run-up and find the move that wins material.",
  "_comment_id": "Resolved against the ORIGIN, not against this manifest's folder. './' would resolve to /Chess-Visualization/ on github.io — which is what it used to be, and why Android could not install this alongside another app on the same gnocchipup.github.io origin: Chrome keys an installed app by origin+id, so two PWAs sharing one origin with a relative id collide and the second install silently replaces the first. Spelling the id as an absolute path with the repo name gives this app a distinct, stable identity. It deliberately does NOT need to live under scope, and it survives a move to a different folder, since only the origin has to match. Must be changed if the app is ever served from a different path on another host.",
  "id": "/Chess-Visualization/",
  "start_url": "/Chess-Visualization/",
  "scope": "/Chess-Visualization/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#181512",
  "theme_color": "#181512",
  "categories": ["education", "games"],
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}